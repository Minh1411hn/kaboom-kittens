# Copy to .env and adjust.

PORT=3000

# Host port for the compose Redis. Change it if 6379 is already in use by
# another project, and update NUXT_REDIS_URL to match.
REDIS_PORT=6379

# Server-only
NUXT_REDIS_URL=redis://localhost:6379
NUXT_NOPE_WINDOW_MS=5000
NUXT_TURN_TIMEOUT_MS=45000
NUXT_ROOM_TTL_SECONDS=21600
NUXT_DISCONNECT_GRACE_MS=60000

# Exposed to the browser
NUXT_PUBLIC_BASE_URL=http://localhost:3000
NUXT_PUBLIC_MAX_PLAYERS=10

# Cloudflare Realtime SFU (voice chat). Leave empty to disable voice.
# Dashboard -> Realtime -> SFU -> create an app.
NUXT_REALTIME_APP_ID=
NUXT_REALTIME_APP_SECRET=
